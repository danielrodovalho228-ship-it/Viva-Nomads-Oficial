{
  "name": "viva-nomads",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "templates:supabase": "node scripts/gerar-templates-supabase.ts",
    "test": "node --test 'src/**/*.test.ts' 'tests/atendimento/*.test.ts' 'tests/laboratorio/*.test.ts' 'tests/migracoes/*.test.ts'",
    "check:consistency": "node scripts/check-consistency.mjs",
    "e2e": "node e2e/all.mjs",
    "testes": "playwright test",
    "testes:publico": "TESTES_SO_PUBLICO=1 playwright test --project=chromium t1-auth-guards t7-fluxo-publico t10-buscar-url t18-seo-a11y t253-orcamento-na-pagina-do-parceiro t271-varredura-paginas",
    "testes:criticos": "playwright test --grep @criticos",
    "testes:report": "playwright show-report",
    "seed:teste": "node scripts/seed-test-data.mjs",
    "seed:massa": "node scripts/seed-teste/index.mjs",
    "check:migracoes": "node scripts/check-migracoes.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "capturas": "node scripts/capturas-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/leaflet": "1.9.12",
    "clsx": "^2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "^1.20.0",
    "mapbox-gl": "^3.24.1",
    "next": "16.2.9",
    "pdf-lib": "^1.17.1",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
