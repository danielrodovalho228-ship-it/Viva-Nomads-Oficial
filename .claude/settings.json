{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull origin claude*)",
      "Bash(git pull origin main*)",
      "Bash(git rev-parse*)",
      "Bash(git checkout claude*)",
      "Bash(git checkout -b claude*)",
      "Bash(git checkout -B claude*)",
      "Bash(git switch claude*)",
      "Bash(git switch -c claude*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push -u origin claude*)",
      "Bash(git push origin claude*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx playwright *)",
      "Bash(supabase *)",
      "Bash(npx supabase *)",
      "mcp__Supabase__execute_sql",
      "mcp__Supabase__apply_migration",
      "mcp__Supabase__list_tables",
      "mcp__Supabase__list_migrations",
      "mcp__Supabase__query_logs",
      "mcp__Supabase__get_advisors",
      "mcp__Supabase__generate_typescript_types",
      "mcp__Supabase__get_project_url"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * *:main)",
      "Bash(*DROP TABLE*)",
      "Bash(*drop table*)",
      "Bash(*DROP SCHEMA*)",
      "Bash(*drop schema*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*drop database*)",
      "Bash(*TRUNCATE*)",
      "Bash(*truncate table*)"
    ]
  }
}
